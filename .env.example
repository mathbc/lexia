APP_NAME=LexIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5442
DB_DATABASE=lexia
DB_USERNAME=lexia
DB_PASSWORD=lexia

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Como POST /pecas/classificar roda as quatro etapas basicas em paralelo.
# `process` sobe um artisan por task e e o unico driver que serve a um request
# web; `sync` devolve o comportamento em serie, que e a saida se a cota do
# provedor reclamar das requisicoes simultaneas.
CONCURRENCY_DRIVER=process

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@lexia.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tudo local, menos a pesquisa de teses: sete dos oito agentes e os embeddings
# respondem do Ollama da maquina.
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=gpt-oss:20b

# O catalogo de classes ja esta vetorizado com o nomic-embed-text: trocar o
# modelo ou o provedor de embeddings exige
# `php artisan lexia:embed-procedural-classes --fresh`.
AI_EMBEDDINGS_PROVIDER=ollama
OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text

# O Gemini atende um agente so: LegalThesisResearchAgent, que pesquisa nos
# portais oficiais e por isso precisa de busca e leitura de pagina na web —
# coisa que o Ollama nao faz, e nao por falta de configuracao: o
# OllamaGateway::mapTools() lanca RuntimeException no primeiro ProviderTool que
# ve. A chave abaixo e obrigatoria para ele, e so para ele: os outros sete
# agentes seguem locais e AI_PROVIDER continua ollama.
#
# Para mandar TODO o texto para a nuvem sao dois gestos: descomente a linha
# AI_PROVIDER abaixo e troque o #[Provider('ollama')] dos sete agentes locais
# pela linha comentada logo acima de cada um.
# AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash

AI_CONTEXT_WINDOW=24576
AI_DESCRIPTION_BUDGET=16000
