APP_NAME=LexIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5442
DB_DATABASE=lexia
DB_USERNAME=lexia
DB_PASSWORD=lexia

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Como POST /pecas/classificar roda as quatro etapas basicas em paralelo.
# `process` sobe um artisan por task e e o unico driver que serve a um request
# web; `sync` devolve o comportamento em serie, que e a saida se a cota do
# provedor reclamar das requisicoes simultaneas.
CONCURRENCY_DRIVER=process
# Teto de cada task em `process` (segundos). Sem ele o filho herda os 60s do
# PendingProcess e a pesquisa de teses morre com "exceeded the timeout of 60
# seconds". Fica acima de 720 (dois agentes de 360s em serie) e abaixo de
# AI_REQUEST_TIME_LIMIT, para o pai gravar o que as outras tasks trouxeram.
CONCURRENCY_TIMEOUT=840

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@lexia.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nem os modelos nem as chaves de API moram aqui. O de texto e o de embeddings
# sao as linhas padrao de ai_models e embedding_models, cadastradas em
# /modelos-de-ia e /modelos-de-embedding e semeadas por `php artisan
# lexia:install` (gemini-3.7-flash e gemini-embedding-001) — e cada linha guarda
# a propria chave, criptografada com a APP_KEY. A chave do Gemini entra pelo
# "Editar" do modelo ou por `php artisan lexia:install --gemini-key=...`.
#
# Trocar a APP_KEY torna as chaves ilegiveis: mova a antiga para
# APP_PREVIOUS_KEYS em vez de descarta-la.
#
# O Ollama so e usado se um modelo dele for o padrao (em desenvolvimento), e o
# daemon local nao pede chave: aqui fica so o endereco.
OLLAMA_URL=http://localhost:11434

# Quanto tempo o modelo fica residente no daemon. O default do Ollama é 5min, e
# toda pausa maior cobra da requisição seguinte a recarga de 12,8 GB.
OLLAMA_KEEP_ALIVE=30m

# Esforço de raciocínio dos agentes que leem e escolhem (low|medium|high), so
# com modelo padrao do Ollama. NUNCA "false": o gpt-oss:20b devolve conteúdo
# vazio. Medido, no agente de pedidos: padrão 156s/lista vazia, low 5,6s/3
# pedidos.
OLLAMA_REASONING_EFFORT=low

AI_CONTEXT_WINDOW=24576
AI_DESCRIPTION_BUDGET=16000

# Teto de execucao do PHP nas rotas que esperam por um agente (segundos), posto
# por AllowLongInference. Nao e o timeout do agente: um php.ini de fabrica traz
# max_execution_time=30 e abate a requisicao em 32s dentro do cURL, com
# "Maximum execution time of 30+2 seconds exceeded (terminated)". 900 cobre o
# pior caso, que e a pesquisa de teses — dois agentes de 360s em serie.
AI_REQUEST_TIME_LIMIT=900
